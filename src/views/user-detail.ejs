<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Detalle de usuario</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/apple-style.css">
</head>

<body>

    <nav>
        <div class="nav-wrapper container">
            <a href="/dashboard/admin" class="brand-logo">Detalle</a>
            <ul class="right">
                <li><a href="/dashboard/admin">Volver</a></li>
                <li><a href="#" onclick="logout()">Cerrar sesión</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <h4>Información del usuario</h4>

        <div class="card">
            <div class="card-content" id="userInfo">
                Cargando información...
            </div>
        </div>
    </div>

    <script>
        const DEFAULT_PROFILE_IMAGE = 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png';
        const userId = "<%= userId %>";

        function logout() {
            sessionStorage.removeItem('token');
            window.location.href = '/signIn';
        }

        function getValidProfileImage(url) {
            if (!url || url.trim() === '') {
                return DEFAULT_PROFILE_IMAGE;
            }

            return url.trim();
        }

        function formatDate(dateValue) {
            if (!dateValue) return 'Sin fecha';

            const date = new Date(dateValue);

            return date.toLocaleString('es-PE', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        async function validateAdminAccess(token) {
            const response = await fetch('/api/users/me', {
                headers: {
                    Authorization: `Bearer ${token}`
                }
            });

            if (response.status === 401) {
                sessionStorage.removeItem('token');
                window.location.href = '/signIn';
                return false;
            }

            if (!response.ok) {
                window.location.href = '/403';
                return false;
            }

            const user = await response.json();

            if (!user.roles || !user.roles.includes('admin')) {
                window.location.href = '/403';
                return false;
            }

            return true;
        }

        async function loadUserDetail() {
            const token = sessionStorage.getItem('token');

            if (!token) {
                window.location.href = '/signIn';
                return;
            }

            const hasAccess = await validateAdminAccess(token);

            if (!hasAccess) {
                return;
            }

            try {
                const response = await fetch('/api/users', {
                    headers: {
                        Authorization: `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    sessionStorage.removeItem('token');
                    window.location.href = '/signIn';
                    return;
                }

                if (response.status === 403) {
                    window.location.href = '/403';
                    return;
                }

                const users = await response.json();
                const user = users.find(u => u.id === userId);

                if (!user) {
                    document.getElementById('userInfo').innerHTML = `
                <div class="center">
                    <span class="apple-badge">No encontrado</span>
                    <h4>Usuario no encontrado</h4>
                    <p class="grey-text text-darken-1">
                        No se encontró información para el usuario solicitado.
                    </p>
                    <a href="/dashboard/admin" class="btn">Volver</a>
                </div>
            `;
                    return;
                }

                const imageUrl = getValidProfileImage(user.url_profile);
                const roles = user.roles && user.roles.length > 0
                    ? user.roles.join(', ')
                    : 'Sin rol';

                document.getElementById('userInfo').innerHTML = `
            <div class="profile-header">
                <img 
                    src="${imageUrl}" 
                    class="profile-avatar" 
                    alt="Foto de perfil"
                    onerror="this.src='${DEFAULT_PROFILE_IMAGE}'"
                >

                <div class="profile-header-text">
                    <span class="apple-badge">${roles}</span>
                    <h4>${user.name || ''} ${user.lastName || ''}</h4>
                    <p class="profile-meta">${user.email || 'Sin email registrado'}</p>
                    <p class="profile-meta">ID: ${user.id}</p>
                </div>
            </div>

            <div class="user-info-grid">
                <div class="user-info-item">
                    <b>Teléfono</b>
                    <span>${user.phoneNumber || 'No registrado'}</span>
                </div>

                <div class="user-info-item">
                    <b>Edad</b>
                    <span>${user.age || 'No calculado'}</span>
                </div>

                <div class="user-info-item">
                    <b>Dirección</b>
                    <span>${user.address || 'No registrado'}</span>
                </div>

                <div class="user-info-item">
                    <b>Roles</b>
                    <span>${roles}</span>
                </div>

                <div class="user-info-item">
                    <b>Fecha de registro</b>
                    <span>${formatDate(user.createdAt)}</span>
                </div>

                <div class="user-info-item">
                    <b>URL de perfil</b>
                    <span>${user.url_profile || 'No registrado'}</span>
                </div>
            </div>
        `;

            } catch (error) {
                console.error(error);

                document.getElementById('userInfo').innerHTML = `
            <div class="center">
                <span class="apple-badge">Error</span>
                <h4>No se pudo cargar la información</h4>
                <p class="red-text">
                    Ocurrió un problema al conectar con el servidor.
                </p>
                <a href="/dashboard/admin" class="btn">Volver</a>
            </div>
        `;
            }
        }

        loadUserDetail();
    </script>

</body>

</html>