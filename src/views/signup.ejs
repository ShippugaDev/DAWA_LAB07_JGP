<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>SignUp</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/apple-style.css">
</head>

<body>

    <div class="auth-wrapper">
        <div class="auth-card-large">
            <div class="card">
                <div class="card-content">
                    <div class="center">
                        <span class="apple-badge">Nueva cuenta</span>
                        <h4>Crear usuario</h4>
                        <p class="grey-text text-darken-1">
                            Completa tus datos para registrarte en la plataforma.
                        </p>
                    </div>

                    <form id="registerForm">
                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input type="text" id="name" required>
                                <label for="name">Nombre</label>
                            </div>

                            <div class="input-field col s12 m6">
                                <input type="text" id="lastName" required>
                                <label for="lastName">Apellido</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input type="text" id="phoneNumber" required>
                                <label for="phoneNumber">Teléfono</label>
                            </div>

                            <div class="input-field col s12 m6">
                                <input type="date" id="birthdate" required>
                                <label class="active" for="birthdate">Fecha de nacimiento</label>
                            </div>
                        </div>

                        <div class="input-field">
                            <input type="email" id="email" required>
                            <label for="email">Correo electrónico</label>
                        </div>

                        <div class="input-field">
                            <input type="password" id="password" required>
                            <label for="password">Contraseña</label>
                        </div>

                        <div class="input-field">
                            <input type="text" id="url_profile">
                            <label for="url_profile">URL de foto de perfil</label>
                        </div>

                        <div class="input-field">
                            <input type="text" id="address">
                            <label for="address">Dirección</label>
                        </div>

                        <div class="center">
                            <button class="btn green waves-effect waves-light" type="submit">
                                Crear cuenta
                            </button>
                        </div>
                    </form>

                    <p class="center" style="margin-top: 24px;">
                        ¿Ya tienes cuenta?
                        <a href="/signIn">Iniciar sesión</a>
                    </p>

                    <p id="error" class="red-text center"></p>
                    <p id="success" class="green-text center"></p>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/signup.js"></script>
</body>

</html>